# Neon PostgreSQL connectiestring (Neon dashboard → Connect → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Google Maps browser-key (Google Cloud Console → Credentials), met
# website-restrictie. Vereiste API's: Maps JavaScript API en Street View
# Static API (alleen voor Street View; kaarten en routes lopen via
# OpenStreetMap).
GOOGLE_MAPS_API_KEY=AIza...

# Master-wachtwoord: werkt als beheerwachtwoord op elke editie en op het
# beheer (/beheer, archiveren). Optioneel — elke editie heeft ook een eigen
# beheerwachtwoord.
ADMIN_PASSWORD=kies-een-goed-wachtwoord

# Eigen domein: de lopende editie staat op het hoofddomein (a4droute.nl),
# afgelopen edities op een subdomein met hun jaartal (2026.a4droute.nl).
BASE_DOMAIN=a4droute.nl

# Optioneel maar aanbevolen: gratis API-key van openrouteservice.org voor het
# berekenen van wandelroutes met eigen quotum. Zonder key gebruikt de app de
# publieke OSM-routediensten (OSRM/Valhalla), die soms overbelast zijn.
ORS_API_KEY=

# Alleen tijdelijk nodig bij het overzetten naar een andere database (bv. een
# andere Neon-regio): zet DATABASE_URL op de nieuwe (lege) database en
# MIGRATE_FROM_URL op de oude. Bij het opstarten kopieert de app dan eenmalig
# alle data van oud naar nieuw — daarna weer weghalen. Staat hij per ongeluk
# nog aan bij een latere deploy, dan gebeurt er niets: de app migreert alleen
# als de nieuwe database nog leeg is.
MIGRATE_FROM_URL=
