# Neon PostgreSQL connectiestring (Neon dashboard → Connect → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Browser-key (Google Cloud Console → Credentials), met website-restrictie.
# Vereiste API's: Maps JavaScript API, Directions API, Geocoding API,
# Maps Static API, Street View Static API
GOOGLE_MAPS_API_KEY=AIza...

# Server-key (tweede key, ZONDER website-restrictie), voor kruisingdetectie.
# Vereiste API's: Roads API én Geocoding API
GOOGLE_MAPS_SERVER_KEY=AIza...

# Zelfgekozen wachtwoord voor de beheerpagina (/admin)
ADMIN_PASSWORD=kies-een-goed-wachtwoord
