# Neon PostgreSQL connectiestring (Neon dashboard → Connect → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Google Maps browser-key (Google Cloud Console → Credentials), met
# website-restrictie. Vereiste API's: Maps JavaScript API, Directions API,
# Geocoding API, Maps Static API, Street View Static API.
# (Kruisingdetectie gebruikt OpenStreetMap en heeft geen key nodig.)
GOOGLE_MAPS_API_KEY=AIza...

# Master-wachtwoord van de platformbeheerder: werkt als beheerwachtwoord op
# élk event (optioneel). Elke avondvierdaagse kiest bij het aanmaken ook een
# eigen beheerwachtwoord.
ADMIN_PASSWORD=kies-een-goed-wachtwoord

# Eigen domein met subdomeinen per event (syncope.a4droute.nl). Zonder deze
# variabele werken alleen de pad-URL's (a4droute.nl/syncope).
BASE_DOMAIN=a4droute.nl
